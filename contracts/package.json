{
  "name": "@heimdall/contracts",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "abi": "node scripts/gen-abi.mjs",
    "test:fork": "FORK=1 hardhat test nodejs test/fork/mainnet.fork.test.ts",
    "deploy:dry": "DRY_RUN=1 hardhat run --build-profile production scripts/deploy.ts --network robinhoodFork",
    "deploy": "npm run size && hardhat run --build-profile production scripts/deploy.ts --network robinhood",
    "size": "hardhat build --force --build-profile production && node scripts/check-size.mjs",
    "test:deep": "hardhat test solidity --test-profile deep"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@safe-global/safe-contracts": "^1.4.1-2",
    "@types/node": "^26.6.6",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "^3.22.0",
    "typescript": "^7.0.2",
    "viem": "^2.58.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "type": "module",
  "private": true
}
