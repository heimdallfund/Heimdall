{
  "name": "@heimdallfund/monitor",
  "version": "0.1.0",
  "description": "Watches every Heimdall vault and the Shield API; posts alerts to a webhook",
  "scripts": {
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-agent": "node scripts/sync-agent.mjs"
  },
  "dependencies": {
    "viem": "^2.58.4",
    "@types/node": "^26.6.6",
    "@heimdallfund/sdk": "^0.4.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true
}
