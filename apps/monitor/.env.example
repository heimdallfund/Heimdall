FACTORY=                # HeimdallVaultFactory address
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
# used when RPC_URL fails; the public RPC comes after it
RPC_URL_BACKUP=https://<name>.robinhood-mainnet.quiknode.pro/<KEY>/
# Wallet Watch pass interval in minutes
WATCH_EVERY_MIN=15
SHIELD_API_URL=https://api.heimdall.fund
ALERT_WEBHOOK_URL=      # Discord, Slack or ntfy.sh webhook; leave empty to log to stdout
INTERVAL_SEC=120
TRADE_LOSS_ALERT_BPS=100     # alert on any single trade losing ≥1% of NAV
DAILY_BUDGET_ALERT_PCT=70    # alert when 70% of the 24h loss budget is used
CAP_ALERT_PCT=95             # note when a vault is 95% of its deposit cap

# Daily jobs (optional)
DEPLOY_BLOCK=           # block the factory was deployed at (vault holder scan starts here)
SHIELD_ADMIN_KEY=       # admin key whose sha256 is SHIELD_ADMIN_KEY_SHA256 on the Shield API: posts the Guardian Points deposit snapshot
SHIELD_HEARTBEAT_KEY=   # narrow key for the status heartbeat only (its sha256 is SHIELD_HEARTBEAT_KEY_SHA256 on Shield)
SPLITTER=               # HeimdallFeeSplitter address
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
KEEPER_KEY=             # small hot wallet that calls distribute(USDG) and executes due Auto-Invest buys; needs a little ETH for gas
AUTOINVEST=             # HeimdallAutoInvest address
# Risk Oracle sync (every RISK_EVERY_MIN minutes): HeimdallRiskOracle address and the reporter's hot key (setReporter by the Safe)
RISK_ORACLE=
RISK_REPORTER_KEY=
RISK_EVERY_MIN=10
# Agent Passport: once a day, publish changed Heimdall Scores to the ERC-8004 Reputation Registry.
# PASSPORT_KEY's address must equal PASSPORT_PUBLISHER_ADDRESS on Shield. It needs a little ETH for gas.
PASSPORT_KEY=
