NODE_ENV=production
PORT=8787

# Receipt signer — production: AWS KMS key (spec ECC_SECG_P256K1, usage SIGN_VERIFY)
SHIELD_KMS_KEY_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# …or a local key for staging only
SHIELD_SIGNER_KEY=

# Paid RPC (public endpoint is the automatic fallback)
RPC_URL_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
RPC_URL_TESTNET=https://robinhood-testnet.g.alchemy.com/v2/<KEY>
# Second paid provider, used when the first errors or times out (the public RPC is the last resort)
RPC_URL_MAINNET_BACKUP=https://<name>.robinhood-mainnet.quiknode.pro/<KEY>/
# Per-request RPC timeout (ms). Local forks only: RPC_NO_PUBLIC_FALLBACK=1 so a slow fork never falls through to mainnet
RPC_TIMEOUT_MS=10000
# RPC_NO_PUBLIC_FALLBACK=1

# Counters for rate limits, quotas, usage and stats (memory if unset — single instance only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API keys: comma-separated name:sha256(key) — create with scripts/new-api-key.ts
SHIELD_API_KEYS=
SHIELD_REQUIRE_KEY=false
SHIELD_FREE_RPM=30
SHIELD_PRO_RPM=600
SHIELD_FREE_DAILY=1000
SHIELD_CORS_ORIGINS=https://heimdall.fund,https://www.heimdall.fund

# Wallet Check
GOLDRUSH_API_KEY=          # optional: GoldRush approvals API, fastest full-history source
GOLDRUSH_CHAIN=robinhood-mainnet
EXPLORER_API_URL=https://robinhoodchain.blockscout.com
SCAN_MAX_REQUESTS=60       # log requests per scan; unfinished history continues on the next request
LOG_WINDOW=2000000
SCAN_FIRST_TX=1          # 0 skips the first-transaction search (needs an archive RPC)

# Guardian Points admin (review drainer reports, post deposit snapshots): sha256 hex of the admin key
SHIELD_ADMIN_KEY_SHA256=

# Heimdall contracts (named in verdicts and Wallet Check once set)
# $HEIM holders get a bigger free quota (set on launch day). HEIM_HOLDER_ADDRESS = HeimdallHolderBalance (held + staked)
HEIM_HOLDER_ADDRESS=
HEIM_ADDRESS=
HEIM_HOLDER_MIN=100000000000000000000000   # raw units (18 decimals) = 100,000 $HEIM
HEIM_QUOTA_MULTIPLIER=5
HEIMDALL_PAY_ADDRESS=
HEIMDALL_FACTORY_ADDRESS=
HEIMDALL_SIGNALS_ADDRESS=
HEIMDALL_STAKING_ADDRESS=

# Agent Arena seasons (JSON, times in Unix ms UTC)
ARENA_SEASONS=[]

# Wallet Watch (browser push). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@heimdall.fund
HEIMDALL_WEB_URL=https://heimdall.fund
# Early access closes at this time (ISO, UTC). Empty = open.
EARLY_ACCESS_UNTIL=
REFERRAL_SALT=
