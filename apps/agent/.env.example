# Manager wallet = the address that created the vault through the factory
MANAGER_KEY=
VAULT=
RPC_URL_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Uniswap v3 SwapRouter02 on Robinhood Chain (must be an allowed target + spender in the vault)
ROUTER_ADDRESS=
POOL_FEE=3000
# per-token fee tiers when pools differ, e.g. {"0xd060…":500}
POOL_FEES=
# target weights in bps of NAV per stock token; the rest stays in USDG
