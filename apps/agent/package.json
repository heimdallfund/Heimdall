{
  "name": "@heimdallfund/agent",
  "version": "0.1.0",
  "description": "Heimdall reference manager agent: buys signals, checks every trade with Shield, trades a Heimdall vault",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "dry-run": "tsx src/index.ts --once --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heimdallfund/sdk": "^0.4.0",
    "viem": "^2.58.4",
    "zod": "^4.6.7",
    "@types/node": "^26.6.6"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true
}
