NODE_ENV=production
PORT=8788
RPC_URL_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/<KEY>
HEIMDALL_SIGNALS_ADDRESS=
# signal IDs returned by HeimdallSignals.register(...) for each official signal
SIGNAL_ID_TOKEN_RISK=
SIGNAL_ID_ADDRESS_INTEL=
SIGNAL_ID_STOCK_PREMIUM=
# prices per call in USDG base units (6 decimals): 20000 = $0.02
PRICE_TOKEN_RISK=20000
PRICE_ADDRESS_INTEL=10000
PRICE_STOCK_PREMIUM=50000
# stock premium sources: onchain pools + an exchange reference price API (URL template with {symbol})
STOCK_POOLS={"NVDA":{"pool":"0x…","token":"0x…","quoteDecimals":6,"tokenDecimals":18}}
REFERENCE_PRICE_URL=
REFERENCE_PRICE_PATH=price
# accepted-voucher ledger (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# redeemer (scripts/redeem.ts)
PROVIDER_KEY=
